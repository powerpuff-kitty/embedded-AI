{
  "name": "embedded-ai-catalog",
  "version": "0.2.0",
  "type": "module",
  "description": "Evidence-first, machine-readable catalogue of on-device and embedded AI models, toolkits and non-AI primitives, with an offline plain-language need matcher.",
  "license": "MIT",
  "homepage": "https://powerpuff-kitty.github.io/embedded-AI/",
  "repository": {"type": "git", "url": "git+https://github.com/powerpuff-kitty/embedded-AI.git"},
  "bugs": {"url": "https://github.com/powerpuff-kitty/embedded-AI/issues"},
  "keywords": ["edge-ai", "embedded-ai", "on-device-ml", "tinyml", "model-catalog", "machine-learning", "dataset", "offline"],
  "engines": {"node": ">=18.17"},
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./catalog.json": "./generated/catalog.json",
    "./catalog.full.json": "./generated/catalog.full.json",
    "./coverage.json": "./generated/coverage.json"
  },
  "files": ["lib/", "site/needs.mjs", "generated/*.json", "README.md", "LICENSE", "LICENSE-DATA"],
  "sideEffects": false,
  "publishConfig": {"access": "public"},
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "index": "tsx scripts/generate-index.ts",
    "search": "tsx scripts/search.ts",
    "need": "tsx scripts/need.ts",
    "links": "tsx scripts/links.ts",
    "audit": "tsx scripts/audit.ts",
    "licences": "tsx scripts/licences.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run validate && npm test && npm run index -- --check",
    "site:build": "tsx scripts/build-site.ts",
    "site:serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "test:python": "python3 -m unittest discover -s tests_python -v",
    "bench": "python3 -m bench.runner",
    "reviews:check": "tsx scripts/review-priority.ts --check",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {"ajv": "8.20.0", "tsx": "4.23.15", "yaml": "2.9.1"}
}
