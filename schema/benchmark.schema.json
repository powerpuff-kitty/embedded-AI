{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observed process benchmark, never inferred hardware fit",
  "type": "object",
  "required": ["schema_version", "record_type", "entry_id", "adapter", "recorded_at", "hardware", "model", "source_files", "samples", "warmup", "latency_samples_ms", "latency_ms", "load_ms", "first_inference_ms", "process_peak_rss_mb", "rss_method", "output_check", "scope"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "measured-run"},
    "entry_id": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["dlinear", "silero-vad", "rtmpose"]},
    "recorded_at": {"type": "string", "minLength": 10},
    "hardware": {"type": "object", "required": ["id", "os", "architecture", "cpu", "environment", "python", "packages"], "properties": {"id": {"type": "string", "minLength": 1}, "environment": {"enum": ["local-process", "github-actions"]}}},
    "model": {"type": "object", "required": ["artifact_sha256", "runtime", "precision", "shape", "scope", "input"], "properties": {"artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "source_files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "samples": {"type": "integer", "minimum": 1},
    "warmup": {"type": "integer", "minimum": 0},
    "latency_samples_ms": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
    "latency_ms": {"type": "object", "required": ["p50", "p95", "p99"], "properties": {"p50": {"type": "number", "minimum": 0}, "p95": {"type": "number", "minimum": 0}, "p99": {"type": "number", "minimum": 0}}},
    "load_ms": {"type": "number", "minimum": 0},
    "first_inference_ms": {"type": "number", "minimum": 0},
    "process_peak_rss_mb": {"type": "number", "minimum": 0},
    "output_check": {"type": "object", "required": ["quality_evaluated"], "properties": {"quality_evaluated": {"const": false}}},
    "power_watts": {"type": ["number", "null"], "minimum": 0},
    "accelerator_memory_mb": {"type": ["number", "null"], "minimum": 0},
    "scope": {"type": "string", "minLength": 10}
  },
  "additionalProperties": true
}
