{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "domain",
    "tasks",
    "class",
    "links",
    "model",
    "license",
    "deployment",
    "compatibility",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "class": {
      "type": "string"
    },
    "links": {
      "type": "object"
    },
    "model": {
      "type": "object"
    },
    "license": {
      "type": "object",
      "required": [
        "code",
        "weights"
      ]
    },
    "deployment": {
      "type": "object",
      "required": [
        "offline",
        "targets"
      ]
    },
    "compatibility": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    }
  }
}