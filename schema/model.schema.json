{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embedded AI catalogue entry",
  "type": "object",
  "required": ["id", "name", "domain", "tasks", "class", "links", "model", "license", "deployment", "compatibility", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "tasks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "minItems": 1},
    "class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "kind": {"enum": ["model", "collection", "pipeline", "toolkit", "primitive"]},
    "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["learned", "procedural", "rule-based", "physics-based", "hybrid"]}},
    "procedural": {"type": "object", "additionalProperties": false, "required": ["categories", "integration", "seed_control", "determinism", "controls", "assets", "incremental", "serialization", "evidence_level"], "properties": {"categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["worlds-environments", "vegetation-ecosystems", "images-materials", "motion-behaviour", "audio-music", "foundations", "narrative-text"]}}, "integration": {"enum": ["browser-library", "browser-reference", "native-library", "native-reference", "shader-library"]}, "seed_control": {"enum": ["built-in", "injectable", "not-exposed", "not-applicable", "unknown"]}, "determinism": {"enum": ["conditional", "not-guaranteed", "unknown"]}, "controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "incremental": {"type": ["boolean", "null"]}, "serialization": {"enum": ["configuration", "state", "configuration-and-state", "outputs-only", "none", "unknown"]}, "evidence_level": {"enum": ["documented", "inspected", "reproduced"]}}},
    "recipe": {"type": "object", "additionalProperties": false, "required": ["status", "components", "contracts"], "properties": {"status": {"enum": ["design", "runnable"]}, "components": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "role"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "role": {"type": "string", "minLength": 1}}}}, "contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "entrypoint": {"type": "string", "pattern": "^recipes/[a-zA-Z0-9_./-]+$"}}},
    "description": {"type": "string"},
    "links": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "null"], "format": "http-url"}
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameters": {"type": ["integer", "null"], "minimum": 0},
        "file_size_mb": {"type": ["number", "null"], "minimum": 0},
        "measurement_scope": {"type": "string", "minLength": 1},
        "architecture": {"type": ["string", "null"], "minLength": 1},
        "precision": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "license": {
      "type": "object",
      "required": ["code", "weights"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "weights": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "deployment": {
      "type": "object",
      "required": ["offline", "targets"],
      "additionalProperties": false,
      "properties": {
        "offline": {"type": ["boolean", "null"]},
        "targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "accelerators": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "runtimes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "formats": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "related": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "review": {"type": "object"},
    "notes": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "catalogue_batch": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "learned": {"type": "boolean"},
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "implementations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "embedded_notes": {"type": "string", "minLength": 1},
    "io": {
      "type": "object",
      "required": ["inputs", "outputs", "camera_setup", "temporal_mode", "coordinate_system"],
      "additionalProperties": false,
      "properties": {
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "camera_setup": {"type": "string", "minLength": 1},
        "temporal_mode": {"enum": ["framewise", "causal", "windowed", "offline", "configuration-dependent", "not-applicable", "unknown"]},
        "coordinate_system": {"type": "string", "minLength": 1}
      }
    },
    "compatibility": {
      "type": "array",
      "additionalProperties": false,
      "items": {
        "type": "object",
        "required": ["target", "status"],
        "additionalProperties": false,
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "status": {"enum": ["unsupported", "theoretical", "reported", "reproduced", "unknown"]},
          "evidence": {"type": ["string", "null"], "format": "http-url"},
          "benchmark": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["official", "paper", "vendor", "community", "benchmark"]},
          "url": {"type": "string", "format": "http-url"},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["pretrained", "requires-training", "companion", "unknown"]},
        "training": {"type": "string", "minLength": 1},
        "needs_data": {"type": "string", "minLength": 1},
        "update_strategy": {"type": "string", "minLength": 1}
      }
    },
    "data": {"type": "object"},
    "evaluation": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requirements": {
      "type": "object",
      "properties": {
        "ram_mb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {"type": ["number", "null"], "minimum": 0},
            "measured_peak": {"type": ["number", "null"], "minimum": 0}
          }
        }
      }
    }
  },
  "additionalProperties": false
}
