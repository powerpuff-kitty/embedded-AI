{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Procedural adapter observation, distinct from model/hardware benchmarks",
  "type":"object",
  "required":["schema_version","adapter","entry_id","config","upstream","generation_ms","output_sha256","repeated_output_equal","different_seed_changes_output","output_payload_bytes","javascript_heap_peak_mb","scope","build","observed_at","browser"],
  "additionalProperties":false,
  "properties":{
    "schema_version":{"const":1},
    "adapter":{"enum":["noise","svg","tree","audio"]},
    "entry_id":{"type":"string","minLength":1},
    "config":{"type":"object","required":["adapter","seed","detail"],"additionalProperties":false,"properties":{"adapter":{"enum":["noise","svg","tree","audio"]},"seed":{"type":"integer","minimum":1,"maximum":2147483647},"detail":{"type":"integer","minimum":1,"maximum":3}}},
    "upstream":{"type":"object","required":["entry","package","version","label"],"additionalProperties":false,"properties":{"entry":{"type":"string"},"package":{"type":"string"},"version":{"type":"string"},"label":{"type":"string"}}},
    "generation_ms":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number","minimum":0}},
    "output_sha256":{"$ref":"#/$defs/hash"},
    "repeated_output_equal":{"const":true},
    "different_seed_changes_output":{"type":"boolean"},
    "output_payload_bytes":{"type":"integer","minimum":1,"maximum":1048576},
    "javascript_heap_peak_mb":{"type":"null"},
    "scope":{"type":"string","minLength":30},
    "observed_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "browser":{"type":"string","minLength":1},
    "build":{"type":"object","required":["schema_version","fixture_sha256","bundler_version","dependencies","lock_sha256","bundle_sha256","bundle_bytes","source_tree_sha256","zzfx_source_sha256","adaptations","source","renderer"],"additionalProperties":false,"properties":{
      "schema_version":{"const":1},"fixture_sha256":{"$ref":"#/$defs/hash"},"bundler_version":{"type":"string"},"dependencies":{"type":"object","minProperties":5,"additionalProperties":{"type":"string"}},"lock_sha256":{"$ref":"#/$defs/hash"},"bundle_sha256":{"$ref":"#/$defs/hash"},"bundle_bytes":{"type":"integer","minimum":1},"source_tree_sha256":{"$ref":"#/$defs/hash"},"zzfx_source_sha256":{"$ref":"#/$defs/hash"},"adaptations":{"type":"array","minItems":2,"items":{"type":"string"}},"source":{"const":"recipes/procedural/"},"renderer":{"type":"string","minLength":1}
    }},
    "host_observation":{"type":"object","required":["os","release","architecture","logical_cpus","browser_version","headless","browser_process_tree_peak_rss_mb","sampling_interval_ms","samples","scope"],"additionalProperties":false,"properties":{
      "os":{"type":"string"},"release":{"type":"string"},"architecture":{"type":"string"},"logical_cpus":{"type":["integer","null"],"minimum":1},"browser_version":{"type":"string"},"headless":{"type":"boolean"},"browser_process_tree_peak_rss_mb":{"type":["number","null"],"minimum":0},"sampling_interval_ms":{"const":20},"samples":{"type":"integer","minimum":0},"scope":{"type":"string","minLength":50}
    }}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
