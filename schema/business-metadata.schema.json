{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Usage and evaluation metadata for business-domain entries",
  "type": "object",
  "required": ["kind", "description", "usage", "data", "evaluation", "limitations", "reviewed", "requirements"],
  "properties": {
    "description": {"type": "string", "minLength": 20},
    "usage": {
      "type": "object", "required": ["mode", "training", "needs_data", "update_strategy"], "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["pretrained", "requires-training", "companion", "unknown"]},
        "training": {"type": "string", "minLength": 1},
        "needs_data": {"type": "string", "minLength": 1},
        "update_strategy": {"type": "string", "minLength": 1}
      }
    },
    "data": {
      "type": "object", "required": ["inputs", "outputs", "languages"], "additionalProperties": false,
      "properties": {
        "inputs": {"$ref": "#/$defs/nonemptyStrings"},
        "outputs": {"$ref": "#/$defs/nonemptyStrings"},
        "languages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evaluation": {"$ref": "#/$defs/nonemptyStrings"},
    "limitations": {"$ref": "#/$defs/nonemptyStrings"},
    "requirements": {
      "type": "object", "required": ["ram_mb"],
      "properties": {"ram_mb": {"type": "object", "required": ["minimum", "measured_peak"], "properties": {
        "minimum": {"type": ["number", "null"], "minimum": 0},
        "measured_peak": {"type": ["number", "null"], "minimum": 0}
      }}}
    }
  },
  "allOf": [{
    "if": {"required": ["model"], "properties": {"model": {"anyOf": [
      {"required": ["parameters"], "properties": {"parameters": {"type": "number"}}},
      {"required": ["file_size_mb"], "properties": {"file_size_mb": {"type": "number"}}}
    ]}}},
    "then": {"properties": {"model": {"required": ["measurement_scope"], "properties": {"measurement_scope": {"type": "string", "minLength": 1}}}}}
  }],
  "$defs": {"nonemptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
  "additionalProperties": true
}
